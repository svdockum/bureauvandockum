---
import Basis from '../../layouts/Basis.astro';
import { bedrijf, FUNCTIONS_URL } from '../../lib/bedrijf';
import '../../styles/formulieren.css';
---
<Basis titel="Toegankelijkheidsscan aanvragen" beschrijving="Vraag vrijblijvend een toegankelijkheidsscan van uw website aan voor € 59 excl. btw. Binnen twee werkdagen nemen wij contact op.">
  <div class="wrap pagina">
    <h1>Toegankelijkheidsscan aanvragen</h1>
    <p class="lead">Wij bekijken de toegankelijkheid van uw website: de belangrijkste pagina’s, automatisch en met de hand, met toetsenbord en schermlezer. U krijgt een rapport in gewone taal met de belangrijkste problemen en wat oplossen ongeveer kost.</p>
    <section class="pagina-sectie scan-uitleg" aria-labelledby="werkt-titel">
      <p class="scan-prijs"><strong>€ 59</strong> excl. btw</p>
      <h2 id="werkt-titel">Zo werkt het</h2>
      <ol>
        <li>U vraagt de scan vrijblijvend aan.</li>
        <li>Binnen twee werkdagen nemen wij contact met u op. We stemmen de verwachtingen af en horen waar we extra op moeten letten.</li>
        <li>Daarna doen we de scan en krijgt u het rapport.</li>
      </ol>
    </section>

    <form class="formulier" method="post" action={`${FUNCTIONS_URL}/scan-aanvragen`} data-controleer>
      <div class="foutoverzicht" tabindex="-1" role="group" aria-labelledby="foutoverzicht-titel" hidden>
        <h2 id="foutoverzicht-titel">Controleer deze velden</h2>
        <ul></ul>
      </div>
      <div class="veld">
        <label for="naam">Naam</label>
        <input id="naam" name="naam" autocomplete="name" required maxlength="120" aria-describedby="naam-fout" data-fout="Vul uw naam in." />
        <p class="veldfout" id="naam-fout" hidden></p>
      </div>
      <div class="veld">
        <label for="organisatie">Naam van uw organisatie (niet verplicht)</label>
        <input id="organisatie" name="organisatie" autocomplete="organization" maxlength="120" aria-describedby="organisatie-fout" />
        <p class="veldfout" id="organisatie-fout" hidden></p>
      </div>
      <div class="veld">
        <label for="email">E-mailadres</label>
        <input id="email" name="email" type="email" autocomplete="email" required maxlength="200" aria-describedby="email-fout" data-patroon="^[^\s@]+@[^\s@]+\.[^\s@]+$" data-fout="Vul een geldig e-mailadres in, zoals naam@voorbeeld.nl." />
        <p class="veldfout" id="email-fout" hidden></p>
      </div>
      <div class="veld">
        <label for="telefoon">Telefoonnummer</label>
        <input id="telefoon" name="telefoon" type="tel" autocomplete="tel" required maxlength="40" data-min-cijfers="10" aria-describedby="telefoon-fout" data-fout="Vul een telefoonnummer in van minstens tien cijfers." />
        <p class="veldfout" id="telefoon-fout" hidden></p>
      </div>
      <div class="veld">
        <label for="website">Webadres van uw site</label>
        <input id="website" name="website" type="text" inputmode="url" autocomplete="url" required maxlength="300" aria-describedby="website-fout" data-patroon="^(https?://)?[^\s/@]+\.[^\s/@]+" data-fout-patroon="Dit webadres klopt niet. Vul het in zoals www.uwpraktijk.nl." data-fout="Vul het webadres in dat we scannen, zoals www.uwpraktijk.nl." />
        <p class="veldfout" id="website-fout" hidden></p>
      </div>
      <div class="veld">
        <label for="opmerkingen">Waar moeten we extra op letten? (niet verplicht)</label>
        <textarea id="opmerkingen" name="opmerkingen" rows="5" maxlength="2000" aria-describedby="opmerkingen-fout"></textarea>
        <p class="veldfout" id="opmerkingen-fout" hidden></p>
      </div>
      <div class="lokveld" aria-hidden="true">
        <label for="adres2">Laat dit veld leeg</label>
        <input id="adres2" name="adres2" tabindex="-1" autocomplete="off" />
      </div>
      <button class="knop knop-primair" type="submit">Vraag de scan aan</button>
      <p>Liever eerst mailen? <a href={`mailto:${bedrijf.email}`}>{bedrijf.email}</a></p>
    </form>
  </div>
  <script>import '../../scripts/formulier';</script>
</Basis>

<style>
  h1 { max-width: none; font-size: clamp(1.75rem, 1rem + 4vw, 4.5rem); }
  .scan-prijs { font-size: 1.5rem; letter-spacing: -.02em; }
  .scan-prijs strong { font-size: clamp(2.25rem, 6vw, 3rem); font-weight: 600; line-height: 1.1; }
  .scan-uitleg h2 { font-size: clamp(1.5rem, 3vw, 2rem); line-height: 1.2; margin-top: 2rem; }
</style>
