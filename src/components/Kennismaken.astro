---
const pijl = '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M3 8h10M9 4l4 4-4 4"/></svg>';
---
<section class="cta" id="kennismaken" aria-labelledby="cta-titel">
  <div class="wrap">
    <div class="cta-inner">
      <p class="eyebrow">Kennismaken</p>
      <h2 id="cta-titel">Zullen we kennismaken?</h2>
      <p class="cta-tekst">Laat uw gegevens achter. Binnen één werkdag mailen we u een moment om te bellen.</p>
      <div class="acties">
        <a class="knop knop-primair" href="/terugbellen/">
          <span>Plan een terugbelafspraak</span>
          <span class="knop-icoon" aria-hidden="true" set:html={pijl} />
        </a>
      </div>
    </div>
  </div>
</section>
